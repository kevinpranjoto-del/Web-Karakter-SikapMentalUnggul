# ================================================
# KPPSM API ENVIRONMENT CONFIGURATION
# ================================================
# Copy this file to .env and fill with actual values
# Never commit .env file to git
# ================================================

# ================================================
# DATABASE CONFIGURATION
# ================================================
# For Local / Docker connection:
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword
DB_USER=kppsm_user
DB_PASSWORD=kppsm_password
DB_NAME=kppsm_website
DB_POOL_LIMIT=10


# ================================================
# SERVER CONFIGURATION
# ================================================
NODE_ENV=production
PORT=3000
API_VERSION=v1
API_BASE_URL=https://api.kppsm.com

# ================================================
# JWT AUTHENTICATION
# ================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=86400
JWT_REFRESH_EXPIRE=604800

# ================================================
# FILE UPLOAD CONFIGURATION
# ================================================
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# ================================================
# CORS CONFIGURATION
# ================================================
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ================================================
# LOGGING
# ================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ================================================
# EMAIL CONFIGURATION (Optional - untuk notifikasi)
# ================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@kppsm.com

# ================================================
# PAYMENT GATEWAY (Optional - untuk future features)
# ================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# ================================================
# GOOGLE MAPS (Optional - untuk Google Maps API)
# ================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ================================================
# AWS S3 (Optional - untuk cloud storage)
# ================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_REGION=us-east-1

# ================================================
# REDIS (Optional - untuk caching)
# ================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================================
# GOOGLE ANALYTICS (Optional)
# ================================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ================================================
# APPLICATION SETTINGS
# ================================================
APP_NAME=KPPSM Testimonial Management System
APP_VERSION=1.0.0
SUPPORT_EMAIL=support@kppsm.com

# ================================================
# DEBUG MODE
# ================================================
DEBUG=false
SHOW_ERRORS=false

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# ================================================
# SESSION CONFIGURATION
# ================================================
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=1800000

# ================================================
# NOTES
# ================================================
# Development:
#   - Set NODE_ENV=development
#   - Set DEBUG=true
#   - Use localhost URLs
#
# Production:
#   - Set NODE_ENV=production
#   - Set DEBUG=false
#   - Use HTTPS URLs
#   - Use strong passwords
#   - Use environment-specific keys
#
# Security Tips:
#   - Never share .env file
#   - Use strong JWT_SECRET
#   - Rotate keys regularly
#   - Use environment variables in production
#   - Keep dependencies updated
